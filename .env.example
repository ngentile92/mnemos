# mnemos — variables de entorno. Copiá a .env (chmod 600) y NUNCA lo commitees.
# scripts/bootstrap.sh completa automáticamente todo lo marcado __GENERAR__ y no pisa valores existentes.
# Lo marcado __COMPLETAR__ lo cargás vos (ver docs/SETUP.es.md). Copia maestra del .env: nota segura en Vaultwarden.

# --- Identidad -------------------------------------------------------------------------------
GITHUB_USER=__COMPLETAR__                   # tu login de GitHub (dueño del repo de skills y login permitido)
# HUB_ALLOWED_GITHUB_LOGINS=                 # opcional: logins permitidos separados por coma (default: GITHUB_USER)
MNEMOS_LABEL_PREFIX=io.mnemos                # prefijo de los LaunchAgents de macOS (opcional; reverse-DNS)
SKILLS_DIR=./skills-local                   # skills in a local folder (editable from the dashboard). Delete this line to use GitHub:
SKILLS_REPO=mnemos-skills                   # (GitHub mode only) private skills repo github.com/$GITHUB_USER/$SKILLS_REPO
# COMPOSE_PROJECT_NAME=mnemos                # opcional: proyecto compose = prefijo de volúmenes (cambiarlo = volúmenes NUEVOS)
# COMPOSE_FILE=compose.generated.yaml        # opcional: si tus contextos no son work/personal/side (scripts/render_compose.py)
# RESTIC_TAG=mnemos                          # opcional: tag/host de los snapshots restic
# MNEMOS_OFFSITE_REMOTE=gdrive:mnemos-backups # opcional: remote rclone de la copia offsite
TS_TAILNET=__COMPLETAR__                    # ej. tail1234 (lo de antes de .ts.net; admin de Tailscale → DNS)
NOTEBOOK_TS_NAME=__COMPLETAR__              # nombre MagicDNS de la Mac en el tailnet, ej. my-laptop

# --- Tailscale (auth key reusable, preaprobada, tag:hub-public) ------------------------------
TS_AUTHKEY_PUBLIC=__COMPLETAR__             # tskey-auth-...

# --- Vaultwarden (solo tailnet) --------------------------------------------------------------
VW_DOMAIN=https://__NOTEBOOK_TS_NAME__.__TS_TAILNET__.ts.net   # bootstrap.sh lo arma con las dos de arriba
VW_SIGNUPS_ALLOWED=true                     # true SOLO hasta crear tu cuenta; después false y `docker compose up -d`
VW_ADMIN_TOKEN=                             # opcional: hash Argon2 (docker run --rm -it vaultwarden/server /vaultwarden hash).
                                            # OJO: en este archivo escapá cada $ del hash como $$ (interpolación de compose).

# --- Infisical (solo tailnet) ----------------------------------------------------------------
INFISICAL_ENCRYPTION_KEY=__GENERAR__        # openssl rand -hex 16   (perderla = perder los secretos)
INFISICAL_AUTH_SECRET=__GENERAR__           # openssl rand -base64 32
INFISICAL_DB_PASSWORD=__GENERAR__
INFISICAL_SITE_URL=https://__NOTEBOOK_TS_NAME__.__TS_TAILNET__.ts.net:8443

# --- Cognee (cuentas técnicas; las usa scripts/bootstrap_cognee.py) --------------------------
COGNEE_PW_ADMIN=__GENERAR__
COGNEE_PW_WORK=__GENERAR__
COGNEE_PW_PERSONAL=__GENERAR__
COGNEE_PW_SIDE=__GENERAR__
COGNEE_KEY_WORK=                      # las escribe bootstrap_cognee.py
COGNEE_KEY_PERSONAL=
COGNEE_KEY_SIDE=

# --- Gateway: work ---------------------------------------------------------------------
GH_OAUTH_WORK_ID=__COMPLETAR__        # OAuth App "mnemos-work"
GH_OAUTH_WORK_SECRET=__COMPLETAR__
HUB_JWT_SIGNING_KEY_WORK=__GENERAR__  # openssl rand -hex 32
HUB_STORAGE_KEY_WORK=__GENERAR__      # clave Fernet
HUB_INTERNAL_KEY_WORK=__GENERAR__   # hub-router → this gateway (internal listener; docs/router.md)
INF_MI_WORK_ID=                       # machine identity mi-gw-work (Universal Auth); opcional hasta la etapa 8
INF_MI_WORK_SECRET=

# --- Gateway: personal -----------------------------------------------------------------------
GH_OAUTH_PERSONAL_ID=__COMPLETAR__
GH_OAUTH_PERSONAL_SECRET=__COMPLETAR__
HUB_JWT_SIGNING_KEY_PERSONAL=__GENERAR__
HUB_STORAGE_KEY_PERSONAL=__GENERAR__
HUB_INTERNAL_KEY_PERSONAL=__GENERAR__
INF_MI_PERSONAL_ID=
INF_MI_PERSONAL_SECRET=

# --- Gateway: side ---------------------------------------------------------------------------
GH_OAUTH_SIDE_ID=__COMPLETAR__
GH_OAUTH_SIDE_SECRET=__COMPLETAR__
HUB_JWT_SIGNING_KEY_SIDE=__GENERAR__
HUB_STORAGE_KEY_SIDE=__GENERAR__
HUB_INTERNAL_KEY_SIDE=__GENERAR__
INF_MI_SIDE_ID=
INF_MI_SIDE_SECRET=

# --- Opcional --------------------------------------------------------------------------------
HUB_RECALL_SEARCH_TYPE=GRAPH_COMPLETION     # con only_context=true: no llama al LLM al leer
# Búsqueda local (memory_search mode=auto/hybrid): embeddings con Ollama en el host. Vacío = solo keyword (BM25).
# ollama pull paraphrase-multilingual   (Mac: http://host.docker.internal:11434; Linux: la IP del host en la red de Docker)
HUB_EMBED_URL=
HUB_EMBED_MODEL=
# memory_answer (respuesta con citas, modelo local de Ollama). Vacío = tool desactivada. P. ej. llama3.1:8b
HUB_ANSWER_MODEL=
HUB_LLM_URL=
RESTIC_REPOSITORY=__COMPLETAR__             # destino de backups fuera de la notebook (disco externo, B2, S3...)
RESTIC_PASSWORD=__COMPLETAR__               # guardala en Vaultwarden Y en papel

# --- Alertas del watchdog fuera de la máquina (opcional, apagadas si están vacías) ----------
# 1 alerta por caída y 1 por recuperación (hub-<ctx>, cognee, dashboard), sin hostnames/IPs.
# Probar: ./scripts/hub_watchdog.py --test-alert
# MNEMOS_ALERT_WEBHOOK_URL=                  # POST JSON {text, content, title, message, status}: Slack/Discord incoming webhook
# MNEMOS_ALERT_NTFY_TOPIC=                   # topic de ntfy (tratalo como secreto: elegí uno largo y aleatorio)
# MNEMOS_ALERT_NTFY_SERVER=https://ntfy.sh   # o tu ntfy self-hosted
# MNEMOS_ALERT_COOLDOWN_S=1800               # anti-flapping: no repetir "caído" del mismo componente antes de esto
# MNEMOS_ALERT_NAME=Mnemos                   # prefijo del mensaje

# ---- Login for the MCP clients
# github (default): one GitHub OAuth App per context (GH_OAUTH_<CTX>_ID/_SECRET), only GITHUB_USER may log in.
# local: built-in login, no GitHub app needed. Create the hash with:
#   docker compose run --rm --no-deps gateway-personal python -m hub_gateway.local_auth hash
#   (or .venv/bin/python -m hub_gateway.local_auth hash)
HUB_AUTH_PROVIDER=github
# HUB_LOCAL_USER=alex
# HUB_LOCAL_PASSWORD_HASH=scrypt:...

# --- One connector for every context (optional, docs/router.md) -----------------------------
# COMPOSE_PROFILES=router                   # starts ts-mnemos + hub-router → https://mnemos.<tailnet>.ts.net/mcp
MNEMOS_ROUTER_STORAGE_KEY=__GENERAR__       # Fernet key: router grants and tokens (encrypted)
MNEMOS_ROUTER_ADMIN_KEY=__GENERAR__         # dashboard → router "Connected apps" (127.0.0.1:8210 only)
# Sign-in: HUB_LOCAL_USER + HUB_LOCAL_PASSWORD_HASH above (default), and/or:
# MNEMOS_GOOGLE_CLIENT_ID=                  # Google Cloud OAuth client (Web), redirect https://mnemos.<tailnet>.ts.net/oidc/google/callback
# MNEMOS_GOOGLE_CLIENT_SECRET=
# MNEMOS_ROUTER_ALLOWED_EMAILS=you@example.com
# MNEMOS_ROUTER_GITHUB_CLIENT_ID=           # separate GitHub OAuth app, callback .../oidc/github/callback
# MNEMOS_ROUTER_GITHUB_CLIENT_SECRET=
