# Mnemos — environment variables. Copy to .env (chmod 600) and NEVER commit it.
# scripts/bootstrap.sh fills in everything marked __GENERAR__ (= generated) and never overwrites existing values.
# Values marked __COMPLETAR__ (= fill me in) are yours to set (docs/SETUP.md; full walkthrough: docs/FULL-SETUP.md).
# Master copy of .env: a secure note in Vaultwarden.

# --- Identity --------------------------------------------------------------------------------
GITHUB_USER=__COMPLETAR__                   # your GitHub login (skills repo owner and allowed login). Local login: set HUB_ALLOWED_GITHUB_LOGINS below
# HUB_ALLOWED_GITHUB_LOGINS=                 # optional: allowed logins, comma-separated (default: GITHUB_USER). HUB_AUTH_PROVIDER=local: set it to your HUB_LOCAL_USER
MNEMOS_LABEL_PREFIX=io.mnemos                # prefix of the macOS LaunchAgents (optional; reverse-DNS)
SKILLS_DIR=./skills-local                   # skills in a local folder (editable from the dashboard). Delete this line to use GitHub:
SKILLS_REPO=mnemos-skills                   # (GitHub mode only) private skills repo github.com/$GITHUB_USER/$SKILLS_REPO
# COMPOSE_PROJECT_NAME=mnemos                # optional: compose project = volume prefix (changing it = NEW, empty volumes)
# COMPOSE_FILE=compose.generated.yaml        # optional: if your contexts are not work/personal/side (scripts/render_compose.py)
# RESTIC_TAG=mnemos                          # optional: tag/host of the restic snapshots
# MNEMOS_OFFSITE_REMOTE=gdrive:mnemos-backups # optional: rclone remote for the offsite copy (scripts/offsite_sync.sh)
TS_TAILNET=__COMPLETAR__                    # e.g. tail1234 (the part before .ts.net; Tailscale admin → DNS)
NOTEBOOK_TS_NAME=__COMPLETAR__              # MagicDNS name of the host in the tailnet, e.g. my-laptop
# MNEMOS_EXPOSURE=funnel                     # funnel (default): hubs public through Funnel. tailnet: MagicDNS only, no
                                            # public surface (tailnet clients only; see config/tailscale/policy-snippet.hujson)

# --- Tailscale (reusable, pre-approved auth key tagged tag:hub-public) ----------------------
TS_AUTHKEY_PUBLIC=__COMPLETAR__             # tskey-auth-...

# --- Vaultwarden (tailnet only) --------------------------------------------------------------
VW_DOMAIN=https://__NOTEBOOK_TS_NAME__.__TS_TAILNET__.ts.net   # bootstrap.sh builds it from the two above
VW_SIGNUPS_ALLOWED=true                     # true ONLY until you create your account; then false and `docker compose up -d`
VW_ADMIN_TOKEN=                             # optional: Argon2 hash (docker run --rm -it vaultwarden/server /vaultwarden hash).
                                            # NOTE: in this file escape every $ of the hash as $$ (compose interpolation).

# --- Infisical (tailnet only) ----------------------------------------------------------------
INFISICAL_ENCRYPTION_KEY=__GENERAR__        # openssl rand -hex 16   (lose it = lose the secrets)
INFISICAL_AUTH_SECRET=__GENERAR__           # openssl rand -base64 32
INFISICAL_DB_PASSWORD=__GENERAR__
INFISICAL_SITE_URL=https://__NOTEBOOK_TS_NAME__.__TS_TAILNET__.ts.net:8443

# --- Cognee (service accounts; used by scripts/bootstrap_cognee.py) --------------------------
COGNEE_PW_ADMIN=__GENERAR__
COGNEE_PW_WORK=__GENERAR__
COGNEE_PW_PERSONAL=__GENERAR__
COGNEE_PW_SIDE=__GENERAR__
COGNEE_KEY_WORK=                      # written by bootstrap_cognee.py
COGNEE_KEY_PERSONAL=
COGNEE_KEY_SIDE=

# --- Gateway: work ---------------------------------------------------------------------
GH_OAUTH_WORK_ID=__COMPLETAR__        # OAuth App "mnemos-work" (GitHub login only; ignored with HUB_AUTH_PROVIDER=local)
GH_OAUTH_WORK_SECRET=__COMPLETAR__
HUB_JWT_SIGNING_KEY_WORK=__GENERAR__  # openssl rand -hex 32
HUB_STORAGE_KEY_WORK=__GENERAR__      # Fernet key
HUB_INTERNAL_KEY_WORK=__GENERAR__   # hub-router → this gateway (internal listener; docs/router.md)
INF_MI_WORK_ID=                       # machine identity mi-gw-work (Universal Auth); written by bootstrap_infisical.py
INF_MI_WORK_SECRET=

# --- Gateway: personal -----------------------------------------------------------------------
GH_OAUTH_PERSONAL_ID=__COMPLETAR__
GH_OAUTH_PERSONAL_SECRET=__COMPLETAR__
HUB_JWT_SIGNING_KEY_PERSONAL=__GENERAR__
HUB_STORAGE_KEY_PERSONAL=__GENERAR__
HUB_INTERNAL_KEY_PERSONAL=__GENERAR__
INF_MI_PERSONAL_ID=
INF_MI_PERSONAL_SECRET=

# --- Gateway: side ---------------------------------------------------------------------------
GH_OAUTH_SIDE_ID=__COMPLETAR__
GH_OAUTH_SIDE_SECRET=__COMPLETAR__
HUB_JWT_SIGNING_KEY_SIDE=__GENERAR__
HUB_STORAGE_KEY_SIDE=__GENERAR__
HUB_INTERNAL_KEY_SIDE=__GENERAR__
INF_MI_SIDE_ID=
INF_MI_SIDE_SECRET=

# --- Optional --------------------------------------------------------------------------------
HUB_RECALL_SEARCH_TYPE=GRAPH_COMPLETION     # with only_context=true: no LLM call on reads
# Local semantic search (memory_search mode=auto/hybrid): embeddings from Ollama on the host. Empty = keyword only (BM25).
#   ollama pull paraphrase-multilingual
#   macOS: HUB_EMBED_URL=http://host.docker.internal:11434
#   Linux: the host's Docker bridge IP, e.g. http://172.17.0.1:11434 (ip -4 addr show docker0)
HUB_EMBED_URL=
HUB_EMBED_MODEL=                            # e.g. paraphrase-multilingual
# memory_answer (cited answers written by a local Ollama model). Empty = tool disabled.
HUB_ANSWER_MODEL=                           # e.g. llama3.1:8b (ollama pull llama3.1:8b)
HUB_LLM_URL=                                # Ollama URL for HUB_ANSWER_MODEL; empty = HUB_EMBED_URL
# Nightly memory hygiene (scripts/cognify_nightly.sh, after cognify; reports in ~/mnemos-hygiene):
#   report = rules only (default) | llm = + contradictions/outdated notes via Ollama | apply = + delete EXACT duplicates | off
MNEMOS_HYGIENE=report
# MNEMOS_HYGIENE_MODEL=llama3.1:8b           # Ollama model for MNEMOS_HYGIENE=llm
RESTIC_REPOSITORY=__COMPLETAR__             # backup target off the laptop (external disk, B2, S3...)
RESTIC_PASSWORD=__COMPLETAR__               # keep it in Vaultwarden AND on paper

# --- Watchdog alerts off the machine (optional, off when empty) ----------------------------
# 1 alert when a component goes down and 1 when it recovers (hub-<ctx>, cognee, dashboard), no hostnames/IPs.
# ntfy: install the ntfy phone app → Subscribe to topic → the same topic. Test: ./scripts/hub_watchdog.py --test-alert
# MNEMOS_ALERT_WEBHOOK_URL=                  # POST JSON {text, content, title, message, status}: Slack/Discord incoming webhook
# MNEMOS_ALERT_NTFY_TOPIC=                   # ntfy topic (treat it as a secret: long and random)
# MNEMOS_ALERT_NTFY_SERVER=https://ntfy.sh   # or your self-hosted ntfy
# MNEMOS_ALERT_COOLDOWN_S=1800               # anti-flapping: don't repeat "down" for the same component before this
# MNEMOS_ALERT_NAME=Mnemos                   # message prefix

# ---- Login for the MCP clients
# github (default): one GitHub OAuth App per context (GH_OAUTH_<CTX>_ID/_SECRET), only GITHUB_USER may log in.
# local: built-in login, no GitHub app needed. Create the hash with:
#   docker compose run --rm --no-deps gateway-personal python -m hub_gateway.local_auth hash
#   (or .venv/bin/python -m hub_gateway.local_auth hash)
HUB_AUTH_PROVIDER=github
# HUB_LOCAL_USER=alex
# HUB_LOCAL_PASSWORD_HASH=scrypt:...
# HUB_PASSKEYS=1          # optional: also allow passkeys (WebAuthn) in the built-in login; enroll at https://<hub>/passkey/enroll

# --- One connector for every context (optional, docs/router.md) -----------------------------
# COMPOSE_PROFILES=router                   # starts ts-mnemos + hub-router → https://mnemos.<tailnet>.ts.net/mcp
MNEMOS_ROUTER_STORAGE_KEY=__GENERAR__       # Fernet key: router grants and tokens (encrypted)
MNEMOS_ROUTER_ADMIN_KEY=__GENERAR__         # dashboard → router "Connected apps" (127.0.0.1:8210 only)
# Sign-in: HUB_LOCAL_USER + HUB_LOCAL_PASSWORD_HASH above (default), and/or:
# MNEMOS_GOOGLE_CLIENT_ID=                  # Google Cloud OAuth client (Web), redirect https://mnemos.<tailnet>.ts.net/oidc/google/callback
# MNEMOS_GOOGLE_CLIENT_SECRET=
# MNEMOS_ROUTER_ALLOWED_EMAILS=you@example.com
# MNEMOS_ROUTER_GITHUB_CLIENT_ID=           # separate GitHub OAuth app, callback .../oidc/github/callback
# MNEMOS_ROUTER_GITHUB_CLIENT_SECRET=
# MNEMOS_DASHBOARD_PORT=8790   # dashboard port (not 8787: desktop apps use it for OAuth sign-in)
