# Cognee para tests locales SIN costo: LLM falso (dev/mock-llm) + embeddings locales (fastembed).
# No sirve para uso real: la extracción de grafo queda vacía.
ENABLE_BACKEND_ACCESS_CONTROL=true
REQUIRE_AUTHENTICATION=true
FASTAPI_USERS_JWT_SECRET=dev-only-not-secret
FASTAPI_USERS_RESET_PASSWORD_TOKEN_SECRET=dev-only-not-secret
FASTAPI_USERS_VERIFICATION_TOKEN_SECRET=dev-only-not-secret
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
LLM_ENDPOINT=http://mock-llm:11435/v1
LLM_API_KEY=sk-dev-mock-no-real-key
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
TELEMETRY_DISABLED=1
COGNEE_LOG_SEARCH_HISTORY=false
SYSTEM_ROOT_DIRECTORY=/cognee-storage/system
DATA_ROOT_DIRECTORY=/cognee-storage/data
