# Cognee — copiá a cognee.env (chmod 600). Elegí UNA opción de LLM (ver docs/SETUP.es.md, paso 7).
# ENABLE_BACKEND_ACCESS_CONTROL se fija desde el día uno: si lo cambiás después, los datos no migran.
ENABLE_BACKEND_ACCESS_CONTROL=true
REQUIRE_AUTHENTICATION=true
FASTAPI_USERS_JWT_SECRET=__GENERAR__
FASTAPI_USERS_RESET_PASSWORD_TOKEN_SECRET=__GENERAR__
FASTAPI_USERS_VERIFICATION_TOKEN_SECRET=__GENERAR__
TELEMETRY_DISABLED=1
COGNEE_LOG_SEARCH_HISTORY=false
SYSTEM_ROOT_DIRECTORY=/cognee-storage/system
DATA_ROOT_DIRECTORY=/cognee-storage/data

# ---- Opción A: API de un proveedor (recomendada para calidad de extracción) ----
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=__COMPLETAR__

# ---- Opción B: Ollama en la Mac (sin costo; más lento). Descomentá y comentá la A. ----
# Docker Desktop llega al host con host.docker.internal.
# IMPORTANTE: con Ollama usá el framework `instructor` + endpoint CON /v1. El default (litellm_native) no sabe que
# llama3.1 soporta JSON schema y cae a "modo JSON" sin gramática: el 8b devuelve campos faltantes o listas donde van
# strings, falla la validación (KnowledgeGraph / SummarizedContent) y un solo chunk malo tira el cognify de TODO el
# dataset (quedan 0 nodos). Con instructor, Ollama aplica el schema como gramática y la salida siempre valida.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b          # validado por Cognee para extracción; qwen2.5 da warning (schema/drops)
# STRUCTURED_OUTPUT_FRAMEWORK=instructor
# LLM_ENDPOINT=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# OLLAMA_NUM_CTX=8192            # default 2048: se queda corto para prompt + schema + chunk

# ---- Embeddings: se fijan el día uno. Cambiarlos después obliga a reindexar todo. ----
# Local, gratis y multilingüe (CPU, ~220 MB la primera vez; tus notas están en español).
# Recomendado aunque uses la opción A: leer y escribir no depende de una API paga para embeddings.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Alternativa multilingüe/mejor calidad con OpenAI (pago):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=openai/text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
