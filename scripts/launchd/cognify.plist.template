<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plantilla: la instala scripts/install_cognify_agent.sh reemplazando __HUB_DIR__ y __HOME__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__.cognify</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HUB_DIR__/scripts/cognify_nightly.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HUB_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MNEMOS_LABEL_PREFIX</key>
    <string>__LABEL__</string>
  </dict>
  <!-- Todos los días a las 03:47 hora local (30 min después del backup de las 03:17, que para Cognee).
       Si la Mac estaba dormida, launchd lo corre al despertar; cognify_nightly.sh espera a que termine el backup. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>47</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/mnemos-cognify.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/mnemos-cognify.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
